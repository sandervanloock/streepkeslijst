rules_version = '2';

// Placeholder: any signed-in user can read and write. Real per-role rules
// (drankleider, beheerder, audit trail) land with TASK-1 and the data model.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
