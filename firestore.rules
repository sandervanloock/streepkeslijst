rules_version = '2';

// Real rules for the ledger data model (TASK-3). TASK-7 makes membership
// explicit: any signed-in Google account used to get full access (see the
// TASK-7 backlog notes), which is effectively open to the internet. Now
// users/{uid} may only be created when an invites/{email} doc grants it, and
// the ledger collections require that users/{uid} doc to already exist.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isBeheerder() {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'beheerder';
    }

    function isDrankleider() {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['drankleider', 'beheerder'];
    }

    match /users/{uid} {
      // Reading your own doc is always allowed (a fresh sign-in has to be able
      // to see it doesn't exist yet); reading the rest of the roster needs
      // membership. Creating your own doc needs a matching invite — this is
      // the atomic claim in auth.ts's claimInvite, which deletes that invite
      // doc in the same batch. A beheerder still writes anyone's role (TASK-6).
      // ponytail: "never zero beheerders" needs a count over the whole
      // collection, which rules cannot do, so it stays a client-side guard in
      // Beheer.tsx. Worst case a beheerder with devtools open demotes the last
      // one and the role is restored from the console, same as the first-time seed.
      allow read: if request.auth != null && (request.auth.uid == uid || isMember());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()));
      allow update: if request.auth.uid == uid || isBeheerder();
      allow delete: if false;
    }

    match /invites/{email} {
      // Only a beheerder hands invites out, reshares or revokes them (TASK-7
      // AC9). The one exception is the invitee's own atomic claim above: they
      // may delete the invite that names their own address, as the second half
      // of the same writeBatch that creates their users/{uid} doc.
      allow read, create, update: if isBeheerder();
      allow delete: if isBeheerder()
        || (request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == email);
    }

    match /meta/group {
      // Seeded on first load by useGroup (data.ts), renamed only in Beheer.
      allow read: if isMember();
      allow create: if request.auth != null;
      allow update: if isBeheerder();
      allow delete: if false;
    }

    match /periods/{periodId} {
      // TASK-10: one collection, one source of truth — the running period
      // lives here too (meta/period is gone), carrying its own start/eind
      // next to startAt/eindAt (Timestamps, for the binnenPeriode() compare
      // below). Rules cannot check that a period's range is contiguous with
      // its neighbours — a drankleider with devtools open can write a bad
      // range, same trust level as the role itself. Read-only from the
      // client; only a drankleider/beheerder writes it, via Afsluiten's
      // sluitPeriode. ponytail: a genuinely empty periods collection (a
      // brand-new install) needs periods/p1 seeded by hand as part of
      // standing the group up, the same one-off console step the very first
      // beheerder already needs — nobody without a role passes isDrankleider() either.
      allow read: if isMember();
      allow create, update: if isDrankleider();
      allow delete: if false;

      // TASK-10 AC4: an entry may only be created or deleted while its
      // period is the active one — what the old frozen-totals archive used
      // to protect against (an old entry deleted to shrink a settled bill),
      // now enforced here instead. One get() per streep: reversed on purpose
      // from TASK-8's plan, which refused it as too expensive on the hottest
      // path — at this app's scale (one Chiro group, a few hundred entries a
      // period) a stale amount is a money bug, an extra read is a rounding error.
      function binnenPeriode() {
        let p = get(/databases/$(database)/documents/periods/$(periodId)).data;
        return request.time >= p.startAt
          && (p.eindAt == null || request.time < p.eindAt + duration.value(1, 'd'));
      }

      match /guests/{guestId} {
        allow read, create: if isMember();
        allow update, delete: if false;
      }

      // TASK-9's Betalen: doc id is the personRef ("user:<uid>" or "guest:<gid>"),
      // not the uid, so a guest's payment — recorded by the drankleider in the
      // out-of-scope Inningen — has somewhere to live too (see the plan's step 8
      // amendment). A member's self-claim is therefore a plain string compare,
      // never a get() or a split(): "user:" + request.auth.uid == betalingId.
      // A guest doc (betalingId starting "guest:") never matches that compare,
      // so it falls straight through to the isDrankleider() arm below — only a
      // drankleider can ever set or clear a guest's status, which is correct
      // since a guest cannot claim anything themselves.
      match /betalingen/{betalingId} {
        allow read: if isMember();
        allow create, update: if isDrankleider()
          || (betalingId == 'user:' + request.auth.uid && request.resource.data.status == 'gemeld');
        allow delete: if isDrankleider()
          || (betalingId == 'user:' + request.auth.uid && resource.data.status != 'betaald');
      }

      match /entries/{entryId} {
        // Append-only audit trail: you can only create an entry attributed to
        // yourself, never edit one, and "undo" is deleting your own entry.
        // TASK-10 AC4: create and delete additionally require binnenPeriode() —
        // strepen and schrappen only work on the period that is active today.
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.by == request.auth.uid && binnenPeriode();
        allow update: if false;
        allow delete: if isMember() && resource.data.by == request.auth.uid && binnenPeriode();
      }
    }
  }
}
