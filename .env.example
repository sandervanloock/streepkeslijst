# Example environment file. Copy to .env.local (gitignored) if you need it.
#
# You normally need none of this: `npm run dev` talks to the 'develop' Firestore
# database and `npm run build` talks to 'prod', decided by the build mode.
# Set VITE_FIRESTORE_DB only when a build has to point somewhere its mode does
# not imply, e.g. a production bundle deployed to a staging site.
VITE_FIRESTORE_DB=develop
